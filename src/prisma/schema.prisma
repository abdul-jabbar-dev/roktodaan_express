generator client {
  provider = "prisma-client-js"
  output   = "app/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GENDER {
  Male
  Female
}

enum BloodGroup {
  A_POS  @map("A+")
  A_NEG  @map("A-")
  B_POS  @map("B+")
  B_NEG  @map("B-")
  O_POS  @map("O+")
  O_NEG  @map("O-")
  AB_POS @map("AB+")
  AB_NEG @map("AB-")
}

model User {
 id       String     @id @default(uuid())
  profile            Profile?
  credential         Credential?
  address            Address?
  donationExperience DonationExperience[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Profile {
   id       String     @id @default(uuid())
  fullName    String
  age         Int
  email       String    @unique
  phoneNumber String    
  weight      Int
  img         String?
  bod         String?
  occupation  String?
  gender      GENDER
  bloodGroup  BloodGroup
  activeDoner Boolean    @default(true)

  user   User @relation(fields: [userId], references: [id])
  userId String  @unique
}

model Credential {
 id       String     @id @default(uuid())
  password      String    @default(uuid())
  randomPasswod Boolean?
  isVerify      Boolean   @default(false)
  otp           Int?
  otpTime       DateTime?
  otpExp        DateTime?

  user   User @relation(fields: [userId], references: [id])
  userId String  @unique
}

model Address {
  id       String     @id @default(uuid())
  area     String?
  division String
  district String
  upazila  String
  user     User    @relation(fields: [userId], references: [id])
  userId   String     @unique
}

model DonationExperience {
  id                   String    @id @default(uuid())
  lastDonationDate     String
  lastDonationLocation String

  user   User @relation(fields: [userId], references: [id])
  userId String
}
